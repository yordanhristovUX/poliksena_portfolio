{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "description": "Design tokens for the portfolio/blog site. Generated from Figma via MCP. Do not edit the derived tokens.css and tokens.ts — regenerate them using scripts/build-tokens.mjs."
  },

  "color": {
    "$type": "color",

    "primitive": {
      "neutral": {
        "0": { "$value": "#ffffff", "$description": "Pure white" },
        "50": { "$value": "#fafafa" },
        "100": { "$value": "#f5f5f5" },
        "200": { "$value": "#e5e5e5" },
        "300": { "$value": "#d4d4d4" },
        "400": { "$value": "#a3a3a3" },
        "500": { "$value": "#737373" },
        "600": { "$value": "#525252" },
        "700": { "$value": "#404040" },
        "800": { "$value": "#262626" },
        "900": { "$value": "#171717" },
        "950": { "$value": "#0a0a0a" },
        "1000": { "$value": "#000000", "$description": "Pure black" }
      },
      "brand": {
        "50": { "$value": "#f0f9ff" },
        "100": { "$value": "#e0f2fe" },
        "200": { "$value": "#bae6fd" },
        "300": { "$value": "#7dd3fc" },
        "400": { "$value": "#38bdf8" },
        "500": { "$value": "#0ea5e9" },
        "600": { "$value": "#0284c7" },
        "700": { "$value": "#0369a1" },
        "800": { "$value": "#075985" },
        "900": { "$value": "#0c4a6e" }
      },
      "success": {
        "500": { "$value": "#22c55e" },
        "700": { "$value": "#15803d" }
      },
      "warning": {
        "500": { "$value": "#f59e0b" },
        "700": { "$value": "#b45309" }
      },
      "error": {
        "500": { "$value": "#ef4444" },
        "700": { "$value": "#b91c1c" }
      }
    },

    "semantic": {
      "$description": "Semantic tokens reference primitives. These are what components use.",
      "background": {
        "default": { "$value": "{color.primitive.neutral.0}", "$description": "Page background" },
        "subtle": {
          "$value": "{color.primitive.neutral.50}",
          "$description": "Subtle surface (cards, sidebars)"
        },
        "muted": {
          "$value": "{color.primitive.neutral.100}",
          "$description": "Muted surface (code blocks, tags)"
        },
        "inverted": {
          "$value": "{color.primitive.neutral.900}",
          "$description": "Inverted surface"
        }
      },
      "foreground": {
        "default": { "$value": "{color.primitive.neutral.900}", "$description": "Primary text" },
        "muted": {
          "$value": "{color.primitive.neutral.500}",
          "$description": "Secondary/muted text"
        },
        "subtle": {
          "$value": "{color.primitive.neutral.400}",
          "$description": "Placeholder, disabled"
        },
        "inverted": {
          "$value": "{color.primitive.neutral.0}",
          "$description": "Text on dark surfaces"
        }
      },
      "border": {
        "default": { "$value": "{color.primitive.neutral.200}" },
        "strong": { "$value": "{color.primitive.neutral.300}" }
      },
      "brand": {
        "default": { "$value": "{color.primitive.brand.500}" },
        "hover": { "$value": "{color.primitive.brand.600}" },
        "subtle": { "$value": "{color.primitive.brand.50}" },
        "foreground": { "$value": "{color.primitive.neutral.0}" }
      },

      "dark": {
        "$description": "Dark mode overrides — applied under [data-theme=dark]",
        "background": {
          "default": { "$value": "{color.primitive.neutral.950}" },
          "subtle": { "$value": "{color.primitive.neutral.900}" },
          "muted": { "$value": "{color.primitive.neutral.800}" },
          "inverted": { "$value": "{color.primitive.neutral.0}" }
        },
        "foreground": {
          "default": { "$value": "{color.primitive.neutral.50}" },
          "muted": { "$value": "{color.primitive.neutral.400}" },
          "subtle": { "$value": "{color.primitive.neutral.600}" },
          "inverted": { "$value": "{color.primitive.neutral.900}" }
        },
        "border": {
          "default": { "$value": "{color.primitive.neutral.800}" },
          "strong": { "$value": "{color.primitive.neutral.700}" }
        },
        "brand": {
          "default": { "$value": "{color.primitive.brand.400}" },
          "hover": { "$value": "{color.primitive.brand.300}" },
          "subtle": { "$value": "{color.primitive.brand.900}" },
          "foreground": { "$value": "{color.primitive.neutral.950}" }
        }
      }
    }
  },

  "typography": {
    "$description": "Typography tokens. Font families are loaded via next/font/google.",
    "fontFamily": {
      "sans": { "$type": "fontFamily", "$value": "Inter, ui-sans-serif, system-ui, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "JetBrains Mono, ui-monospace, monospace" },
      "serif": { "$type": "fontFamily", "$value": "Lora, ui-serif, Georgia, serif" }
    },
    "fontSize": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem", "$description": "12px" },
      "sm": { "$value": "0.875rem", "$description": "14px" },
      "base": { "$value": "1rem", "$description": "16px" },
      "lg": { "$value": "1.125rem", "$description": "18px" },
      "xl": { "$value": "1.25rem", "$description": "20px" },
      "2xl": { "$value": "1.5rem", "$description": "24px" },
      "3xl": { "$value": "1.875rem", "$description": "30px" },
      "4xl": { "$value": "2.25rem", "$description": "36px" },
      "5xl": { "$value": "3rem", "$description": "48px" },
      "6xl": { "$value": "3.75rem", "$description": "60px" }
    },
    "fontWeight": {
      "regular": { "$type": "number", "$value": 400 },
      "medium": { "$type": "number", "$value": 500 },
      "semibold": { "$type": "number", "$value": 600 },
      "bold": { "$type": "number", "$value": 700 }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.25 },
      "snug": { "$type": "number", "$value": 1.375 },
      "normal": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.625 },
      "loose": { "$type": "number", "$value": 2 }
    },
    "letterSpacing": {
      "tight": { "$type": "dimension", "$value": "-0.05em" },
      "snug": { "$type": "dimension", "$value": "-0.025em" },
      "normal": { "$type": "dimension", "$value": "0em" },
      "wide": { "$type": "dimension", "$value": "0.025em" },
      "wider": { "$type": "dimension", "$value": "0.05em" },
      "widest": { "$type": "dimension", "$value": "0.1em" }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "4px base grid",
    "0": { "$value": "0px" },
    "px": { "$value": "1px" },
    "0.5": { "$value": "0.125rem", "$description": "2px" },
    "1": { "$value": "0.25rem", "$description": "4px" },
    "1.5": { "$value": "0.375rem", "$description": "6px" },
    "2": { "$value": "0.5rem", "$description": "8px" },
    "2.5": { "$value": "0.625rem", "$description": "10px" },
    "3": { "$value": "0.75rem", "$description": "12px" },
    "3.5": { "$value": "0.875rem", "$description": "14px" },
    "4": { "$value": "1rem", "$description": "16px" },
    "5": { "$value": "1.25rem", "$description": "20px" },
    "6": { "$value": "1.5rem", "$description": "24px" },
    "7": { "$value": "1.75rem", "$description": "28px" },
    "8": { "$value": "2rem", "$description": "32px" },
    "9": { "$value": "2.25rem", "$description": "36px" },
    "10": { "$value": "2.5rem", "$description": "40px" },
    "12": { "$value": "3rem", "$description": "48px" },
    "14": { "$value": "3.5rem", "$description": "56px" },
    "16": { "$value": "4rem", "$description": "64px" },
    "20": { "$value": "5rem", "$description": "80px" },
    "24": { "$value": "6rem", "$description": "96px" },
    "28": { "$value": "7rem", "$description": "112px" },
    "32": { "$value": "8rem", "$description": "128px" }
  },

  "borderRadius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "0.125rem", "$description": "2px" },
    "base": { "$value": "0.25rem", "$description": "4px" },
    "md": { "$value": "0.375rem", "$description": "6px" },
    "lg": { "$value": "0.5rem", "$description": "8px" },
    "xl": { "$value": "0.75rem", "$description": "12px" },
    "2xl": { "$value": "1rem", "$description": "16px" },
    "3xl": { "$value": "1.5rem", "$description": "24px" },
    "full": { "$value": "9999px" }
  },

  "shadow": {
    "$type": "shadow",
    "none": { "$value": "none" },
    "sm": { "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)" },
    "base": { "$value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)" },
    "md": { "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)" },
    "lg": { "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)" },
    "xl": { "$value": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" },
      "fast": { "$value": "100ms" },
      "normal": { "$value": "200ms" },
      "slow": { "$value": "300ms" },
      "slower": { "$value": "500ms" }
    },
    "easing": {
      "linear": { "$type": "cubicBezier", "$value": [0, 0, 1, 1] },
      "ease": { "$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1] },
      "ease-in": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] },
      "ease-out": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
      "ease-in-out": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
      "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] }
    }
  },

  "zIndex": {
    "base": { "$type": "number", "$value": 0 },
    "raised": { "$type": "number", "$value": 10 },
    "overlay": { "$type": "number", "$value": 20 },
    "modal": { "$type": "number", "$value": 30 },
    "toast": { "$type": "number", "$value": 40 },
    "tooltip": { "$type": "number", "$value": 50 }
  }
}
