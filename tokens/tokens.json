{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "description": "Design tokens extracted from Figma file: Portfolio Poliksena Christova 2026 (v1qXozCZAmrIcU9ojr7Vth). Do not edit tokens.css or tokens.ts — regenerate with: npm run tokens."
  },

  "color": {
    "$type": "color",

    "primitive": {
      "$description": "Raw palette extracted from Figma. Components reference semantic tokens, not primitives.",
      "neutral": {
        "0": { "$value": "#ffffff" },
        "50": { "$value": "#f7f7f6", "$description": "Lightest background surface" },
        "100": { "$value": "#f5f5f0", "$description": "Off-white page background" },
        "150": { "$value": "#f6f6f5" },
        "200": { "$value": "#ccd1c7", "$description": "Subtle border / divider" },
        "300": { "$value": "#afb4aa", "$description": "Muted border" },
        "400": { "$value": "#999999", "$description": "Placeholder / disabled text" },
        "500": { "$value": "#959595", "$description": "Secondary text" },
        "600": { "$value": "#5e6459", "$description": "Muted foreground" },
        "700": { "$value": "#404540", "$description": "Medium dark surface" },
        "800": { "$value": "#2c2c2c", "$description": "Dark surface" },
        "850": { "$value": "#2b2e2b", "$description": "Dark surface variant" },
        "900": { "$value": "#1f1b1b", "$description": "Near-black surface" },
        "950": { "$value": "#141414", "$description": "Primary foreground" },
        "1000": { "$value": "#000000" }
      },
      "teal": {
        "300": { "$value": "#3cc8c8", "$description": "Teal mid" },
        "400": { "$value": "#1ce3af", "$description": "Brand teal — primary accent" }
      },
      "purple": {
        "400": { "$value": "#9747ff", "$description": "Secondary accent" },
        "500": { "$value": "#6e0070" },
        "600": { "$value": "#4b004f" }
      },
      "yellow": {
        "400": { "$value": "#fad91f", "$description": "Highlight" },
        "500": { "$value": "#fff200" }
      },
      "orange": {
        "400": { "$value": "#ff8a00" },
        "500": { "$value": "#da720e" }
      },
      "red": {
        "400": { "$value": "#f04654" },
        "500": { "$value": "#c71826" }
      },
      "green": {
        "400": { "$value": "#18a24a" },
        "500": { "$value": "#157937" }
      }
    },

    "semantic": {
      "$description": "Intent-based aliases. All components use these — never primitives.",
      "background": {
        "default": { "$value": "{color.primitive.neutral.100}" },
        "subtle": { "$value": "{color.primitive.neutral.50}" },
        "muted": { "$value": "{color.primitive.neutral.150}" },
        "inverted": { "$value": "{color.primitive.neutral.950}" }
      },
      "foreground": {
        "default": { "$value": "{color.primitive.neutral.950}" },
        "muted": { "$value": "{color.primitive.neutral.600}" },
        "subtle": { "$value": "{color.primitive.neutral.500}" },
        "inverted": { "$value": "{color.primitive.neutral.0}" }
      },
      "border": {
        "default": { "$value": "{color.primitive.neutral.200}" },
        "strong": { "$value": "{color.primitive.neutral.300}" }
      },
      "brand": {
        "default": { "$value": "{color.primitive.teal.400}" },
        "hover": { "$value": "{color.primitive.teal.300}" },
        "subtle": { "$value": "#e6fdf8" },
        "foreground": { "$value": "{color.primitive.neutral.950}" }
      },
      "accent": {
        "default": { "$value": "{color.primitive.purple.400}" },
        "foreground": { "$value": "{color.primitive.neutral.0}" }
      },

      "dark": {
        "$description": "Dark mode overrides applied under [data-theme=dark]",
        "background": {
          "default": { "$value": "{color.primitive.neutral.950}" },
          "subtle": { "$value": "{color.primitive.neutral.900}" },
          "muted": { "$value": "{color.primitive.neutral.850}" },
          "inverted": { "$value": "{color.primitive.neutral.100}" }
        },
        "foreground": {
          "default": { "$value": "{color.primitive.neutral.50}" },
          "muted": { "$value": "{color.primitive.neutral.400}" },
          "subtle": { "$value": "{color.primitive.neutral.500}" },
          "inverted": { "$value": "{color.primitive.neutral.950}" }
        },
        "border": {
          "default": { "$value": "{color.primitive.neutral.800}" },
          "strong": { "$value": "{color.primitive.neutral.700}" }
        },
        "brand": {
          "default": { "$value": "{color.primitive.teal.400}" },
          "hover": { "$value": "{color.primitive.teal.300}" },
          "subtle": { "$value": "#0a2e28" },
          "foreground": { "$value": "{color.primitive.neutral.950}" }
        },
        "accent": {
          "default": { "$value": "{color.primitive.purple.400}" },
          "foreground": { "$value": "{color.primitive.neutral.0}" }
        }
      }
    }
  },

  "typography": {
    "$description": "Bricolage Grotesque = display/headings, Inter = body, Archivo Narrow = labels.",
    "fontFamily": {
      "display": {
        "$type": "fontFamily",
        "$value": "'Bricolage Grotesque', ui-sans-serif, sans-serif"
      },
      "body": { "$type": "fontFamily", "$value": "Inter, ui-sans-serif, system-ui, sans-serif" },
      "label": { "$type": "fontFamily", "$value": "'Archivo Narrow', ui-sans-serif, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "'JetBrains Mono', ui-monospace, monospace" }
    },
    "fontSize": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem", "$description": "12px" },
      "sm": { "$value": "0.875rem", "$description": "14px" },
      "base": { "$value": "1rem", "$description": "16px" },
      "lg": { "$value": "1.5rem", "$description": "24px" },
      "xl": { "$value": "2.5rem", "$description": "40px" },
      "2xl": { "$value": "3.5rem", "$description": "56px" },
      "3xl": { "$value": "4rem", "$description": "64px" },
      "4xl": { "$value": "7.5rem", "$description": "120px" },
      "5xl": { "$value": "11.25rem", "$description": "180px" }
    },
    "fontWeight": {
      "regular": { "$type": "number", "$value": 400 },
      "medium": { "$type": "number", "$value": 500 },
      "semibold": { "$type": "number", "$value": 600 },
      "extrabold": { "$type": "number", "$value": 800 }
    },
    "lineHeight": {
      "none": { "$type": "number", "$value": 1 },
      "tight": { "$type": "number", "$value": 1.1 },
      "snug": { "$type": "number", "$value": 1.2 },
      "normal": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.625 }
    },
    "letterSpacing": {
      "tighter": { "$type": "dimension", "$value": "-0.01em" },
      "tight": { "$type": "dimension", "$value": "-0.005em" },
      "normal": { "$type": "dimension", "$value": "0em" },
      "wide": { "$type": "dimension", "$value": "0.04em" },
      "wider": { "$type": "dimension", "$value": "0.06em" }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "Extracted from Figma frame gaps and paddings.",
    "0": { "$value": "0px" },
    "px": { "$value": "1px" },
    "1": { "$value": "0.25rem", "$description": "4px" },
    "1.5": { "$value": "0.375rem", "$description": "6px" },
    "2": { "$value": "0.5rem", "$description": "8px" },
    "2.5": { "$value": "0.625rem", "$description": "10px" },
    "3": { "$value": "0.75rem", "$description": "12px" },
    "4": { "$value": "1rem", "$description": "16px" },
    "5": { "$value": "1.25rem", "$description": "20px" },
    "6": { "$value": "1.5rem", "$description": "24px" },
    "8": { "$value": "2rem", "$description": "32px" },
    "10": { "$value": "2.5rem", "$description": "40px" },
    "12": { "$value": "3rem", "$description": "48px" },
    "15": { "$value": "3.75rem", "$description": "60px" },
    "16": { "$value": "4rem", "$description": "64px" },
    "20": { "$value": "5rem", "$description": "80px" },
    "30": { "$value": "7.5rem", "$description": "120px" },
    "45": { "$value": "11.25rem", "$description": "180px" }
  },

  "borderRadius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "xs": { "$value": "0.125rem", "$description": "2px" },
    "sm": { "$value": "0.375rem", "$description": "6px — tags, chips" },
    "md": { "$value": "0.8125rem", "$description": "13px — cards" },
    "lg": { "$value": "1rem", "$description": "16px — panels" },
    "xl": { "$value": "2rem", "$description": "32px — large cards" },
    "full": { "$value": "999px", "$description": "Pills, avatars" }
  },

  "shadow": {
    "$type": "shadow",
    "none": { "$value": "none" },
    "sm": { "$value": "0 1px 2px 0 rgb(20 20 20 / 0.06)" },
    "base": { "$value": "0 2px 8px 0 rgb(20 20 20 / 0.08), 0 1px 2px 0 rgb(20 20 20 / 0.04)" },
    "md": { "$value": "0 4px 16px 0 rgb(20 20 20 / 0.10), 0 2px 4px 0 rgb(20 20 20 / 0.06)" },
    "lg": { "$value": "0 8px 32px 0 rgb(20 20 20 / 0.12), 0 4px 8px 0 rgb(20 20 20 / 0.06)" },
    "xl": { "$value": "0 16px 48px 0 rgb(20 20 20 / 0.14), 0 8px 16px 0 rgb(20 20 20 / 0.08)" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" },
      "fast": { "$value": "100ms" },
      "normal": { "$value": "200ms" },
      "slow": { "$value": "350ms" },
      "slower": { "$value": "500ms" }
    },
    "easing": {
      "linear": { "$type": "cubicBezier", "$value": [0, 0, 1, 1] },
      "ease": { "$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1] },
      "ease-in": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] },
      "ease-out": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
      "ease-in-out": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
      "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] }
    }
  },

  "zIndex": {
    "base": { "$type": "number", "$value": 0 },
    "raised": { "$type": "number", "$value": 10 },
    "overlay": { "$type": "number", "$value": 20 },
    "modal": { "$type": "number", "$value": 30 },
    "toast": { "$type": "number", "$value": 40 },
    "tooltip": { "$type": "number", "$value": 50 }
  }
}
